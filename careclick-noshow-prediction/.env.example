# Copy this file to ".env" (which is git-ignored) and fill in your own values.
# NEVER commit the real .env file.

# Part 4 - Gemini API (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash

# Part 2 - MySQL (optional; notebook 02 falls back to SQLite if these are not set / reachable)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
